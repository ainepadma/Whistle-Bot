{
    "name": "banyao-desktop-pets",
    "version": "1.0.0",
    "description": "VSCode Pets 桌面版 —— tonybaloney/vscode-pets 的 Windows 桌面移植",
    "main": "vscode-pets/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "build:pets-bundle": "node node_modules/esbuild/bin/esbuild ../third_party/vscode-pets/src/panel/main.ts --bundle --format=iife --global-name=petApp --outfile=vscode-pets/media/main-bundle.js --log-level=warning",
        "build:win": "electron-builder --win portable",
        "build:win:installer": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux"
    },
    "author": "声绘鹞影实践团 · 东南大学吴健雄学院",
    "license": "MIT",
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "esbuild": "^0.28.1"
    },
    "build": {
        "appId": "com.banyao.vscode-pets-desktop",
        "productName": "VSCode Pets 桌面版",
        "directories": {
            "output": "dist"
        },
        "files": [
            "vscode-pets/**/*",
            "build/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.png"
        },
        "mac": {
            "target": "dmg",
            "icon": "build/icon.png"
        },
        "linux": {
            "target": "AppImage",
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
